<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="GridSplitter.panel-splitter">
        <Setter Property="Background" Value="#30303B" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Height="5" Background="{TemplateBinding Background}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                        <Rectangle Width="12" Height="2" Margin="2,2" Fill="#AAAAAA" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="GridSplitter.panel-splitter:pointerover">
        <Setter Property="Background" Value="#2A213B" />
    </Style>
    <Style Selector="GridSplitter.panel-splitter:focus">
        <Setter Property="Background" Value="#2A213B" />
    </Style>
</Styles>
