<UserControl
    x:Class="Cortex.Views.SettingsTabView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rs="using:RangeSlider.Avalonia.Controls"
    xmlns:vm="using:Cortex.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d">
    <UserControl.Styles>
        <Style Selector="ToggleSwitch">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="TextBlock.groupTitle">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.ioFieldLabel">
            <Setter Property="Width" Value="170" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Control.ioFieldInput">
            <Setter Property="Width" Value="170" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*, Auto">
        <TabControl Grid.Row="0">
            <TabItem Header="I/O">
                <Grid ColumnDefinitions="2*,*">
                    <Border
                        Grid.Column="0"
                        Margin="5"
                        BorderBrush="#443553"
                        BorderThickness="1"
                        CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Color="#FF141722" Offset="0" />
                                <GradientStop Color="#FF221C34" Offset="0.5" />
                                <GradientStop Color="#FF302042" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    Classes="sectionTitle"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    Text="Outputs" />
                                <Grid
                                    Margin="10,10,10,10"
                                    HorizontalAlignment="Center"
                                    ColumnDefinitions="170,170,140,120"
                                    ColumnSpacing="10">
                                    <TextBlock
                                        Grid.Column="0"
                                        Classes="ioFieldLabel"
                                        Margin="0,10,0,0"
                                        Text="Channel no.:" />
                                    <ComboBox
                                        Grid.Column="1"
                                        Classes="ioFieldInput"
                                        Margin="0,0,10,0"
                                        ItemsSource="{Binding ChannelDisplayList}"
                                        DisplayMemberBinding="{Binding Label}"
                                        SelectedItem="{Binding SelectedChannelLabel}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="Channel enabled" />
                                    <ToggleSwitch
                                        Grid.Column="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        BorderBrush="#302042"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        IsChecked="{Binding IsChannelGridEnabled}"
                                        OffContent="Disabled"
                                        OnContent="Enabled" />
                                </Grid>
                                <Grid
                                    Margin="10"
                                    HorizontalAlignment="Center"
                                    ColumnDefinitions="Auto,Auto"
                                    ColumnSpacing="40"
                                    IsEnabled="{Binding IsChannelGridEnabled}"
                                    RowSpacing="10">
                                    <Border
                                        Grid.Column="0"
                                        Width="410"
                                        Padding="12"
                                        BorderBrush="#443553"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            Orientation="Vertical"
                                            Spacing="9">
                                        <Grid
                                            HorizontalAlignment="Center"
                                            ColumnDefinitions="170,170"
                                            ColumnSpacing="10">
                                            <TextBlock
                                                Grid.Column="0"
                                                Classes="ioFieldLabel"
                                                Text="Connected device" />
                                            <ComboBox
                                                Grid.Column="1"
                                                Classes="ioFieldInput"
                                                VerticalAlignment="Center"
                                                AutoScrollToSelectedItem="True"
                                                ItemsSource="{Binding ChannelCategories}"
                                                DisplayMemberBinding="{Binding Label}"
                                                ToolTip.Tip="Classify the output by the device or function it powers. This sets the channel priority used by the controller and keeps the configuration readable."
                                                SelectedItem="{Binding SelectedChannelCategoryDisplay}" />
                                        </Grid>
                                        <Grid
                                            HorizontalAlignment="Center"
                                            ColumnDefinitions="170,170"
                                            ColumnSpacing="10">
                                            <TextBlock
                                                Grid.Column="0"
                                                Classes="ioFieldLabel"
                                                Text="Output type" />
                                            <ComboBox
                                                Grid.Column="1"
                                                Classes="ioFieldInput"
                                                VerticalAlignment="Center"
                                                AutoScrollToSelectedItem="True"
                                                ItemsSource="{Binding ChannelTypes}"
                                                DisplayMemberBinding="{Binding Label}"
                                                ToolTip.Tip="Choose how this channel is controlled: digital, analogue threshold, analogue scaled PWM, CAN-controlled, or intermittent."
                                                SelectedItem="{Binding SelectedChannelTypeDisplay}" />
                                        </Grid>
                                        <Grid
                                            HorizontalAlignment="Center"
                                            ColumnDefinitions="170,170"
                                            ColumnSpacing="10">
                                            <TextBlock
                                                Grid.Column="0"
                                                Classes="ioFieldLabel"
                                                Text="Channel name (3 chars.)" />
                                            <TextBox
                                                Grid.Column="1"
                                                Classes="ioFieldInput"
                                                Width="84"
                                                MaxLength="3"
                                                Text="{Binding SelectedChannelName}" />
                                        </Grid>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Current limit" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Current low threshold" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding #chanTHLow.Value}" />
                                                <Slider
                                                    x:Name="chanTHLow"
                                                    Width="200"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="17"
                                                    Minimum="0"
                                                    TickFrequency="1"
                                                    ToolTip.Tip="Turn off threshold low (open circuit detection)"
                                                    Value="{Binding SelectedChannel.CurrentThresholdLow}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Current high threshold" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding #chanTHHigh.Value}" />
                                                <Slider
                                                    x:Name="chanTHHigh"
                                                    Width="200"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="17"
                                                    Minimum="0"
                                                    TickFrequency="1"
                                                    ToolTip.Tip="Turn off threshold high"
                                                    Value="{Binding SelectedChannel.CurrentThresholdHigh}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Inrush delay (seconds)" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding #inrushDelay.Value}" />
                                                <Slider
                                                    x:Name="inrushDelay"
                                                    Width="200"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="2.0"
                                                    Minimum="0"
                                                    TickFrequency="0.1"
                                                    ToolTip.Tip="Time after turn-on during which the inrush current limit is used instead of the normal high current limit."
                                                    Value="{Binding SelectedChannel.InrushDelay}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Inrush current limit" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding #inrushCurrent.Value}" />
                                                <Slider
                                                    x:Name="inrushCurrent"
                                                    Width="200"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="50"
                                                    Minimum="0"
                                                    TickFrequency="1"
                                                    ToolTip.Tip="Temporary higher current limit allowed during the inrush delay period after the channel turns on."
                                                    Value="{Binding SelectedChannel.InrushCurrentLimit}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Retry attempts" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding #retryAttempts.Value}" />
                                                <Slider
                                                    x:Name="retryAttempts"
                                                    Width="200"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="10"
                                                    Minimum="0"
                                                    TickFrequency="1"
                                                    ToolTip.Tip="Number of automatic restart attempts after a channel fault before the output is locked out."
                                                    Value="{Binding SelectedChannel.RetryCount}" />
                                            </StackPanel>
                                        </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Width="410"
                                        Padding="12"
                                        BorderBrush="#443553"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            Orientation="Vertical"
                                            Spacing="9">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            IsEnabled="{Binding IsPWMChannel}"
                                            Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="PWM Duty" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="25"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding #PWMDuty.Value}" />
                                                <Slider
                                                    x:Name="PWMDuty"
                                                    Width="200"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding IsPWMChannel}"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="100"
                                                    Minimum="0"
                                                    TickFrequency="1"
                                                    Value="{Binding SelectedChannel.PWMSetDuty}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            IsVisible="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            Text="Threshold direction" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            IsVisible="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            Orientation="Vertical"
                                            Spacing="4">
                                            <ToggleSwitch
                                                HorizontalAlignment="Center"
                                                IsChecked="{Binding SelectedChannelUsesNegativeGoingThreshold, Mode=TwoWay}"
                                                OffContent="ON above / OFF below"
                                                ToolTip.Tip="Choose whether the analogue threshold turns the output on as the input rises or as the input falls."
                                                OnContent="ON below / OFF above" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Text="{Binding SelectedChannelThresholdDirectionSummary}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap"
                                                Width="260" />
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            IsVisible="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            Text="{Binding SelectedChannelOnThresholdLabel}" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            IsVisible="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                Width="25"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Text="{Binding SelectedChannelOnThresholdDisplay}" />
                                            <Slider
                                                x:Name="chAnaOn"
                                                Width="180"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding SelectedChannelOnThresholdTooltip}"
                                                IsSnapToTickEnabled="True"
                                                Maximum="{Binding SelectedChannelOnThresholdMaximum}"
                                                Minimum="{Binding SelectedChannelOnThresholdMinimum}"
                                                TickFrequency="{Binding SelectedChannelInputTickFrequency}"
                                                Value="{Binding SelectedChannel.OnThreshold, Mode=TwoWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            IsVisible="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            Text="{Binding SelectedChannelOffThresholdLabel}" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            IsVisible="{Binding SelectedChannel.IsAnalogueThresholdChannel}"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                Width="25"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Text="{Binding SelectedChannelOffThresholdDisplay}" />
                                            <Slider
                                                x:Name="chAnaOff"
                                                Width="180"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="{Binding SelectedChannelOffThresholdTooltip}"
                                                IsSnapToTickEnabled="True"
                                                Maximum="{Binding SelectedChannelOffThresholdMaximum}"
                                                Minimum="{Binding SelectedChannelOffThresholdMinimum}"
                                                TickFrequency="{Binding SelectedChannelInputTickFrequency}"
                                                Value="{Binding SelectedChannel.OffThreshold, Mode=TwoWay}" />
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsAnalogueScaledChannel}"
                                            IsVisible="{Binding SelectedChannel.IsAnalogueScaledChannel}"
                                            Text="{Binding SelectedChannelScaleLabel}" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsAnalogueScaledChannel}"
                                            IsVisible="{Binding SelectedChannel.IsAnalogueScaledChannel}"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                Width="25"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Text="{Binding SelectedChannelScaleMinDisplay}" />
                                            <rs:RangeSlider
                                                x:Name="chScaleRange"
                                                Width="180"
                                                IsThumbOverlap="True"
                                                LowerSelectedValue="{Binding SelectedChannel.ScaleMin, Mode=TwoWay}"
                                                Maximum="{Binding SelectedChannelInputMaximum}"
                                                Minimum="{Binding SelectedChannelInputMinimum}"
                                                ToolTip.Tip="Input range that is mapped across the PWM output range for analogue scaled channels."
                                                UpperSelectedValue="{Binding SelectedChannel.ScaleMax, Mode=TwoWay}" />
                                            <TextBlock
                                                Width="25"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Text="{Binding SelectedChannelScaleMaxDisplay}" />
                                        </StackPanel>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsAnalogueScaledChannel}"
                                            IsVisible="{Binding SelectedChannel.IsAnalogueScaledChannel}"
                                            Text="PWM output range (% duty)" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsAnalogueScaledChannel}"
                                            IsVisible="{Binding SelectedChannel.IsAnalogueScaledChannel}"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <TextBlock
                                                Width="25"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Text="{Binding SelectedChannel.PWMMin, StringFormat=F0, Mode=TwoWay}" />
                                            <rs:RangeSlider
                                                x:Name="chPwmRange"
                                                Width="180"
                                                IsThumbOverlap="True"
                                                LowerSelectedValue="{Binding SelectedChannel.PWMMin, Mode=TwoWay}"
                                                Maximum="100"
                                                Minimum="0"
                                                ToolTip.Tip="Minimum and maximum PWM duty the channel will output across the selected input scale range."
                                                UpperSelectedValue="{Binding SelectedChannel.PWMMax, Mode=TwoWay}" />
                                            <TextBlock
                                                Width="25"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Text="{Binding SelectedChannel.PWMMax, StringFormat=F0, Mode=TwoWay}" />
                                        </StackPanel>
                                        <Grid
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            ColumnDefinitions="170,170"
                                            ColumnSpacing="10">
                                            <TextBlock
                                                Grid.Column="0"
                                                Classes="ioFieldLabel"
                                                Text="Control input" />
                                            <ComboBox
                                                Grid.Column="1"
                                                Classes="ioFieldInput"
                                                Width="170"
                                                VerticalAlignment="Center"
                                                AutoScrollToSelectedItem="True"
                                                ItemsSource="{Binding InputDisplayList}"
                                                DisplayMemberBinding="{Binding Label}"
                                                ToolTip.Tip="Select which physical input controls this output channel."
                                                SelectedItem="{Binding SelectedInputLabel}" />
                                        </Grid>
                                        <TextBlock
                                            Width="260"
                                            HorizontalAlignment="Center"
                                            IsVisible="{Binding SelectedChannel.IsIntermittentChannel}"
                                            Text="Intermittent mode requires a digital input or an ana/dig input configured as Digital."
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsIntermittentChannel}"
                                            IsVisible="{Binding SelectedChannel.IsIntermittentChannel}"
                                            Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Intermittent ON time (seconds)" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="35"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding #intermittentOn.Value, StringFormat='{}{0:F1}'}" />
                                                <Slider
                                                    x:Name="intermittentOn"
                                                    Width="200"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="10.0"
                                                    Minimum="0"
                                                    TickFrequency="0.1"
                                                    Value="{Binding SelectedChannel.IntermittentOnTime}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsIntermittentChannel}"
                                            IsVisible="{Binding SelectedChannel.IsIntermittentChannel}"
                                            Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Intermittent OFF time (seconds)" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="35"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding #intermittentOff.Value, StringFormat='{}{0:F1}'}" />
                                                <Slider
                                                    x:Name="intermittentOff"
                                                    Width="200"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="10.0"
                                                    Minimum="0"
                                                    TickFrequency="0.1"
                                                    Value="{Binding SelectedChannel.IntermittentOffTime}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            Content="Enable delayed on"
                                            ToolTip.Tip="Wait for the selected time after the input turns on before enabling the output."
                                            IsChecked="{Binding SelectedChannel.IsDelayedOnEnabled, Mode=TwoWay}" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsDelayedOnEnabled}"
                                            Orientation="Vertical"
                                            Spacing="6">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Delayed ON duration" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="40"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding SelectedChannel.DelayedOnSliderText}" />
                                                <Slider
                                                    Width="180"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="{Binding SelectedChannel.DelayedOnSliderMaximum}"
                                                    Minimum="{Binding SelectedChannel.DelayedOnSliderMinimum}"
                                                    TickFrequency="{Binding SelectedChannel.DelayedOnSliderTickFrequency}"
                                                    Value="{Binding SelectedChannel.DelayedOnSliderValue, Mode=TwoWay}" />
                                                <ComboBox
                                                    Width="120"
                                                    ToolTip.Tip="Choose the units used for the delayed ON duration slider."
                                                    SelectedIndex="{Binding SelectedChannel.DelayedOnTimeUnitIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="Milliseconds" />
                                                    <ComboBoxItem Content="Seconds" />
                                                    <ComboBoxItem Content="Minutes" />
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>

                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            Content="Enable delayed off"
                                            ToolTip.Tip="Keep the output on for the selected time after the delayed OFF start condition occurs."
                                            IsChecked="{Binding SelectedChannel.IsDelayedOffEnabled, Mode=TwoWay}" />
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            IsEnabled="{Binding SelectedChannel.IsDelayedOffEnabled}"
                                            Orientation="Vertical"
                                            Spacing="6">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Delayed OFF duration" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="40"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding SelectedChannel.DelayedOffSliderText}" />
                                                <Slider
                                                    Width="180"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="{Binding SelectedChannel.DelayedOffSliderMaximum}"
                                                    Minimum="{Binding SelectedChannel.DelayedOffSliderMinimum}"
                                                    TickFrequency="{Binding SelectedChannel.DelayedOffSliderTickFrequency}"
                                                    Value="{Binding SelectedChannel.DelayedOffSliderValue, Mode=TwoWay}" />
                                                <ComboBox
                                                    Width="120"
                                                    ToolTip.Tip="Choose the units used for the delayed OFF duration slider."
                                                    SelectedIndex="{Binding SelectedChannel.DelayedOffTimeUnitIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="Milliseconds" />
                                                    <ComboBoxItem Content="Seconds" />
                                                    <ComboBoxItem Content="Minutes" />
                                                </ComboBox>
                                            </StackPanel>
                                            <Grid
                                                HorizontalAlignment="Center"
                                                ColumnDefinitions="170,170"
                                                ColumnSpacing="10">
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Classes="ioFieldLabel"
                                                    Text="Delayed OFF starts on" />
                                                <ToggleSwitch
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="#302042"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    IsChecked="{Binding SelectedChannel.DelayedOffUsesAssignedInputTrigger, Mode=TwoWay}"
                                                    OffContent="Ignition off"
                                                    OnContent="Assigned input"
                                                    ToolTip.Tip="Select what starts the delayed OFF timer: Ignition off starts the timer when IGN turns off. Assigned input starts the timer when the configured input turns off." />
                                            </Grid>
                                        </StackPanel>

                                        <Grid
                                            HorizontalAlignment="Center"
                                            ColumnDefinitions="170,170"
                                            ColumnSpacing="10">
                                            <TextBlock
                                                Grid.Column="0"
                                                Classes="ioFieldLabel"
                                                Text="Soft start" />
                                            <ToggleSwitch
                                                x:Name="SSTS"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                BorderBrush="#302042"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                OffContent="Disabled"
                                                ToolTip.Tip="Ramp the output up from 0 to its target duty when the channel turns on."
                                                OnContent="Enabled"
                                                IsChecked="{Binding SelectedChannel.SoftStartEnabled, Mode=TwoWay}"/>
                                        </Grid>
                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Soft start duration (seconds)" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="35"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding #softStart.Value, StringFormat='{}{0:F1}'}" />
                                                <Slider
                                                    x:Name="softStart"
                                                    Width="200"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding #SSTS.IsChecked}"
                                                    Value="{Binding SelectedChannel.SoftStartTime}"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="5.0"
                                                    Minimum="0"
                                                    TickFrequency="0.1" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid
                                            HorizontalAlignment="Center"
                                            ColumnDefinitions="170,170"
                                            ColumnSpacing="10">
                                            <TextBlock
                                                Grid.Column="0"
                                                Classes="ioFieldLabel"
                                                Text="Soft stop" />
                                            <ToggleSwitch
                                                x:Name="SStTS"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                BorderBrush="#302042"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                OffContent="Disabled"
                                                ToolTip.Tip="Ramp the output down instead of turning it off immediately when the channel is disabled."
                                                OnContent="Enabled"
                                                IsChecked="{Binding SelectedChannel.SoftStopEnabled, Mode=TwoWay}"/>
                                        </Grid>
                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Soft stop duration (seconds)" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Width="35"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding #softStop.Value, StringFormat='{}{0:F1}'}" />
                                                <Slider
                                                    x:Name="softStop"
                                                    Width="200"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding #SStTS.IsChecked}"
                                                    Value="{Binding SelectedChannel.SoftStopTime}"
                                                    IsSnapToTickEnabled="True"
                                                    Maximum="5.0"
                                                    Minimum="0"
                                                    TickFrequency="0.1" />
                                            </StackPanel>
                                        </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Column="1" RowDefinitions="Auto,*">
                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5"
                            BorderBrush="#443553"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#FF141722" Offset="0" />
                                    <GradientStop Color="#FF221C34" Offset="0.5" />
                                    <GradientStop Color="#FF302042" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="8">
                                    <TextBlock
                                        Classes="sectionTitle"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        Text="Analogue Inputs" />
                                    <Grid
                                        HorizontalAlignment="Center"
                                        ColumnDefinitions="170,170"
                                        ColumnSpacing="10">
                                        <TextBlock
                                            Grid.Column="0"
                                            Classes="ioFieldLabel"
                                            Text="Input no.:" />
                                        <ComboBox
                                            Grid.Column="1"
                                            Classes="ioFieldInput"
                                            Width="100"
                                            ItemsSource="{Binding SettingsDataView.AnalogueInputsStaticData}"
                                            DisplayMemberBinding="{Binding InputNumber}"
                                            SelectedItem="{Binding SelectedAnalogueInput, Mode=TwoWay}" />
                                    </Grid>
                                    <StackPanel
                                        Width="360"
                                        HorizontalAlignment="Center"
                                        Orientation="Vertical"
                                        Spacing="12">
                                        <Border
                                            Width="320"
                                            Padding="12"
                                            HorizontalAlignment="Center"
                                            BorderBrush="#443553"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel
                                                Orientation="Vertical"
                                                Spacing="8">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Input type" />
                                            <ComboBox
                                                Width="160"
                                                HorizontalAlignment="Center"
                                                ItemsSource="{Binding AnalogueChannelTypes}"
                                                DisplayMemberBinding="{Binding Label}"
                                                SelectedValueBinding="{Binding Type}"
                                                SelectedValue="{Binding SelectedAnalogueInput.ChanType, Mode=TwoWay}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Units" />
                                            <ComboBox
                                                Width="160"
                                                HorizontalAlignment="Center"
                                                IsEnabled="{Binding SelectedAnalogueInput.IsUnitsSelectable}"
                                                ItemsSource="{Binding FilteredAnalogueUnits}"
                                                DisplayMemberBinding="{Binding Label}"
                                                SelectedValueBinding="{Binding Units}"
                                                SelectedValue="{Binding SelectedAnalogueInput.Units, Mode=TwoWay}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Pull-up" />
                                            <ToggleSwitch
                                                Grid.Column="1"
                                                Width="110"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding SelectedAnalogueInput.AllowPullResistors}"
                                                BorderBrush="#302042"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                IsChecked="{Binding SelectedAnalogueInput.PullUpEnable, Mode=TwoWay}"
                                                OffContent="Disabled"
                                                OnContent="Enabled" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Pull-down" />
                                            <ToggleSwitch
                                                Grid.Column="1"
                                                Width="110"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsEnabled="{Binding SelectedAnalogueInput.AllowPullResistors}"
                                                BorderBrush="#302042"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                IsChecked="{Binding SelectedAnalogueInput.PullDownEnable, Mode=TwoWay}"
                                                OffContent="Disabled"
                                                OnContent="Enabled" />
                                            </StackPanel>
                                        </Border>
                                        <Border
                                            Width="320"
                                            Margin="0,4,0,0"
                                            Padding="12"
                                            HorizontalAlignment="Center"
                                            IsVisible="{Binding SelectedAnalogueInput.HasDetailSettings}"
                                            BorderBrush="#443553"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel
                                                Orientation="Vertical"
                                                Spacing="8">
                                            <TextBlock
                                                IsVisible="{Binding SelectedAnalogueInput.IsCalibrationMode}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Calibration points" />
                                            <ComboBox
                                                Width="120"
                                                HorizontalAlignment="Center"
                                                IsVisible="{Binding SelectedAnalogueInput.IsCalibrationMode}"
                                                ItemsSource="{Binding AnalogueCalibrationPointOptions}"
                                                SelectedItem="{Binding SelectedAnalogueInput.CalibrationPoints, Mode=TwoWay}" />

                                            <Grid
                                                IsVisible="{Binding SelectedAnalogueInput.IsCalibrationMode}"
                                                ColumnDefinitions="Auto,Auto,Auto"
                                                ColumnSpacing="8"
                                                RowDefinitions="Auto,Auto,Auto,Auto">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Pt" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Volts" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Value" HorizontalAlignment="Center" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="1" HorizontalAlignment="Center" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Width="80" Text="{Binding SelectedAnalogueInput.CalibrationVolt1, Mode=TwoWay}" />
                                                <TextBox Grid.Row="1" Grid.Column="2" Width="80" Text="{Binding SelectedAnalogueInput.CalibrationValue1, Mode=TwoWay}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="2" HorizontalAlignment="Center" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Width="80" Text="{Binding SelectedAnalogueInput.CalibrationVolt2, Mode=TwoWay}" />
                                                <TextBox Grid.Row="2" Grid.Column="2" Width="80" Text="{Binding SelectedAnalogueInput.CalibrationValue2, Mode=TwoWay}" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Text="3" HorizontalAlignment="Center" IsVisible="{Binding SelectedAnalogueInput.IsThreePointCalibration}" />
                                                <TextBox Grid.Row="3" Grid.Column="1" Width="80" Text="{Binding SelectedAnalogueInput.CalibrationVolt3, Mode=TwoWay}" IsVisible="{Binding SelectedAnalogueInput.IsThreePointCalibration}" />
                                                <TextBox Grid.Row="3" Grid.Column="2" Width="80" Text="{Binding SelectedAnalogueInput.CalibrationValue3, Mode=TwoWay}" IsVisible="{Binding SelectedAnalogueInput.IsThreePointCalibration}" />
                                            </Grid>

                                            <TextBlock
                                                IsVisible="{Binding SelectedAnalogueInput.IsCalibrationMode}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="Channel input range (min / max)" />
                                            <StackPanel
                                                IsVisible="{Binding SelectedAnalogueInput.IsCalibrationMode}"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBox
                                                    Width="80"
                                                    HorizontalAlignment="Center"
                                                    Text="{Binding SelectedAnalogueInput.ConfigRangeMin, Mode=TwoWay}" />
                                                <TextBox
                                                    Width="80"
                                                    HorizontalAlignment="Center"
                                                    Text="{Binding SelectedAnalogueInput.ConfigRangeMax, Mode=TwoWay}" />
                                            </StackPanel>

                                            <TextBlock
                                                IsVisible="{Binding SelectedAnalogueInput.IsNtcMode}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="NTC Beta" />
                                            <TextBox
                                                IsVisible="{Binding SelectedAnalogueInput.IsNtcMode}"
                                                Width="150"
                                                HorizontalAlignment="Center"
                                                Text="{Binding SelectedAnalogueInput.NtcBeta, Mode=TwoWay}" />
                                            <TextBlock
                                                IsVisible="{Binding SelectedAnalogueInput.IsNtcMode}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Text="NTC Resistance @25&#176;C (ohms)" />
                                            <TextBox
                                                IsVisible="{Binding SelectedAnalogueInput.IsNtcMode}"
                                                Width="150"
                                                HorizontalAlignment="Center"
                                                Text="{Binding SelectedAnalogueInput.NtcNominalResistance, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="System">
                <Border
                    Grid.Column="0"
                    Margin="5"
                    BorderBrush="#443553"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FF141722" Offset="0" />
                            <GradientStop Color="#FF221C34" Offset="0.5" />
                            <GradientStop Color="#FF302042" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Grid
                            Margin="14"
                            ColumnDefinitions="*,*,*,*"
                            RowDefinitions="Auto">
                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="6"
                                Padding="14"
                                BorderBrush="#443553"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="9">
                                    <TextBlock
                                        Classes="groupTitle"
                                        Padding="0,0,0,6"
                                        HorizontalAlignment="Center"
                                        Text="GSM / Data / GPS" />
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            Margin="5"
                                            VerticalAlignment="Center"
                                            Text="Mobile data" />
                                        <ToggleSwitch
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            BorderBrush="#302042"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            IsChecked="{Binding SettingsDataView.SystemParamsStaticData.AllowData}"
                                            OffContent="Disabled"
                                            ToolTip.Tip="Allow the controller to use the cellular modem for remote data services. Disable this if the modem should stay inactive."
                                            OnContent="Enabled" />
                                    </StackPanel>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            Margin="5"
                                            VerticalAlignment="Center"
                                            Text="GPS" />
                                        <ToggleSwitch
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            BorderBrush="#302042"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            IsChecked="{Binding SettingsDataView.SystemParamsStaticData.AllowGPS}"
                                            OffContent="Disabled"
                                            ToolTip.Tip="Allow the PDM to use GPS position, speed, and time data."
                                            OnContent="Enabled" />
                                    </StackPanel>
                                    <StackPanel
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Vertical"
                                        Spacing="6">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Text="Cellular data" />
                                        <Grid
                                            HorizontalAlignment="Center"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="10"
                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                            RowSpacing="5">
                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="APN" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Width="170" MaxLength="63" ToolTip.Tip="Access Point Name supplied by the SIM provider." Text="{Binding SettingsDataView.CellularParamsStaticData.APN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="APN user" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Width="170" MaxLength="31" ToolTip.Tip="Optional APN username. Leave blank if the provider does not require one." Text="{Binding SettingsDataView.CellularParamsStaticData.APNUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="APN password" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Width="170" MaxLength="31" PasswordChar="*" ToolTip.Tip="Optional APN password. Leave blank if the provider does not require one." Text="{Binding SettingsDataView.CellularParamsStaticData.APNPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Publish interval (s)" />
                                            <NumericUpDown Grid.Row="3" Grid.Column="1" Width="130" Minimum="5" Maximum="3600" Increment="1" ToolTip.Tip="Target refresh interval for selected telemetry. The PDM publishes values one at a time as the connection allows." Value="{Binding SettingsDataView.CellularParamsStaticData.PublishIntervalSeconds, Mode=TwoWay}" />
                                        </Grid>
                                        <Border
                                            Width="300"
                                            Padding="8"
                                            Background="#17111E"
                                            BorderBrush="#443553"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel Spacing="5">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Text="Telemetry uploads" />
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                                    <CheckBox Grid.Row="0" Grid.Column="0" Content="System voltage" IsChecked="{Binding SettingsDataView.CellularParamsStaticData.UploadSystemVoltage, Mode=TwoWay}" />
                                                    <CheckBox Grid.Row="0" Grid.Column="1" Content="System current" IsChecked="{Binding SettingsDataView.CellularParamsStaticData.UploadSystemCurrent, Mode=TwoWay}" />
                                                    <CheckBox Grid.Row="1" Grid.Column="0" Content="Temperature" IsChecked="{Binding SettingsDataView.CellularParamsStaticData.UploadSystemTemperature, Mode=TwoWay}" />
                                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Uptime" IsChecked="{Binding SettingsDataView.CellularParamsStaticData.UploadUptime, Mode=TwoWay}" />
                                                    <CheckBox Grid.Row="2" Grid.Column="0" Content="GPS data" IsChecked="{Binding SettingsDataView.CellularParamsStaticData.UploadGpsData, Mode=TwoWay}" />
                                                    <CheckBox Grid.Row="2" Grid.Column="1" Content="IMU data" IsChecked="{Binding SettingsDataView.CellularParamsStaticData.UploadImuData, Mode=TwoWay}" />
                                                    <CheckBox Grid.Row="3" Grid.Column="0" Content="Channel currents" IsChecked="{Binding SettingsDataView.CellularParamsStaticData.UploadChannelCurrents, Mode=TwoWay}" />
                                                    <CheckBox Grid.Row="3" Grid.Column="1" Content="Digital inputs" IsChecked="{Binding SettingsDataView.CellularParamsStaticData.UploadDigitalInputs, Mode=TwoWay}" />
                                                    <CheckBox Grid.Row="4" Grid.Column="0" Content="Analogue inputs" IsChecked="{Binding SettingsDataView.CellularParamsStaticData.UploadAnalogueInputs, Mode=TwoWay}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <Grid
                                            HorizontalAlignment="Center"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="10"
                                            IsEnabled="{Binding CanUseOpenRemoteSettings}"
                                            IsVisible="{Binding !IsOpenRemoteSignedIn}"
                                            RowDefinitions="Auto,Auto,Auto"
                                            RowSpacing="5">
                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Realm" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Width="170" ToolTip.Tip="The telemetry service realm your organisation uses." Text="{Binding OpenRemoteRealmInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Username" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Width="170" Text="{Binding OpenRemoteUsernameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Password" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Width="170" PasswordChar="*" Text="{Binding OpenRemotePasswordInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            Content="Stay signed in on this computer"
                                            IsChecked="{Binding StaySignedIn, Mode=TwoWay}"
                                            IsVisible="{Binding !IsOpenRemoteSignedIn}"
                                            ToolTip.Tip="Saves an encrypted session for your Windows account. Your password is never stored." />
                                        <Button
                                            Width="220"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding SignInOpenRemoteCommand}"
                                            Content="{Binding OpenRemoteSignInButtonText}"
                                            IsEnabled="{Binding CanSignInOpenRemote}"
                                            IsVisible="{Binding !IsOpenRemoteSignedIn}"
                                            ToolTip.Tip="Sign in with your telemetry service account to register this PDM." />
                                        <StackPanel HorizontalAlignment="Center" IsVisible="{Binding IsOpenRemoteSignedIn}" Orientation="Horizontal" Spacing="10">
                                            <TextBlock VerticalAlignment="Center" FontSize="14" Opacity="0.82" Text="{Binding OpenRemoteSignedInAs}" />
                                            <Button Command="{Binding SignOutOpenRemoteCommand}" Content="Sign out" />
                                        </StackPanel>
                                        <Grid
                                            HorizontalAlignment="Center"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="10"
                                            IsEnabled="{Binding CanUseOpenRemoteSettings}"
                                            RowDefinitions="Auto"
                                            RowSpacing="5">
                                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="PDM name" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Width="170" MaxLength="27" ToolTip.Tip="The name this PDM will have in the telemetry service. It must be unique within your organisation." Text="{Binding PdmNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <Button
                                            Width="220"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding ProvisionOpenRemoteCommand}"
                                            Content="{Binding OpenRemoteProvisioningButtonText}"
                                            IsEnabled="{Binding CanProvisionOpenRemote}"
                                            IsVisible="{Binding !IsConnectedPdmRegistered}"
                                            ToolTip.Tip="Register this PDM with the telemetry service and configure it automatically." />
                                        <Button
                                            Width="220"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding RenamePdmCommand}"
                                            Content="Rename PDM"
                                            IsEnabled="{Binding CanRenamePdm}"
                                            IsVisible="{Binding IsConnectedPdmRegistered}"
                                            ToolTip.Tip="Change this PDM's name in the telemetry service." />
                                        <Button
                                            Width="220"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding UnregisterPdmCommand}"
                                            Content="Unregister PDM"
                                            IsEnabled="{Binding CanUnregisterPdm}"
                                            IsVisible="{Binding IsConnectedPdmRegistered}"
                                            ToolTip.Tip="Remove this PDM from the telemetry service so it can be sold on or registered by someone else." />
                                        <TextBlock
                                            Width="300"
                                            HorizontalAlignment="Center"
                                            FontSize="14"
                                            Opacity="0.82"
                                            Text="{Binding ConnectedPdmStatusMessage}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Width="300"
                                            HorizontalAlignment="Center"
                                            FontSize="14"
                                            Opacity="0.82"
                                            Text="{Binding OpenRemoteProvisioningStatusMessage}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                        <Border
                                            MinWidth="310"
                                            MaxWidth="360"
                                            Padding="12"
                                            HorizontalAlignment="Center"
                                            Background="#17111E"
                                            BorderBrush="#443553"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel Spacing="6">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="Connection status" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="20"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding CellularConnectionHealthStatus}"
                                                    TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="6"
                                Padding="14"
                                BorderBrush="#443553"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="9">
                                    <TextBlock
                                        Classes="groupTitle"
                                        Padding="0,0,0,6"
                                        HorizontalAlignment="Center"
                                        Text="System" />
                                    <StackPanel
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Vertical"
                                        Spacing="6">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Text="Controller date and time" />
                                        <Grid
                                            HorizontalAlignment="Center"
                                            ColumnDefinitions="Auto"
                                            ColumnSpacing="10"
                                            RowDefinitions="Auto, Auto, Auto, Auto"
                                            RowSpacing="6">
                                            <DatePicker
                                                Grid.Row="0"
                                                Width="220"
                                                MinWidth="220"
                                                MaxWidth="220"
                                                ToolTip.Tip="Date to write to the PDM RTC."
                                                SelectedDate="{Binding ControllerRtcDate, Mode=TwoWay}" />
                                            <TimePicker
                                                Grid.Row="1"
                                                Width="220"
                                                MinWidth="220"
                                                MaxWidth="220"
                                                ToolTip.Tip="Time to write to the PDM RTC."
                                                SelectedTime="{Binding ControllerRtcTime, Mode=TwoWay}" />
                                            <ComboBox
                                                Grid.Row="2"
                                                Width="220"
                                                MinWidth="220"
                                                MaxWidth="220"
                                                ItemsSource="{Binding TimeZones}"
                                                DisplayMemberBinding="{Binding Label}"
                                                ToolTip.Tip="Time zone used when setting the controller RTC from Cortex."
                                                SelectedItem="{Binding SelectedTimeZoneDisplay}" />
                                            <Button
                                                Grid.Row="3"
                                                HorizontalAlignment="Center"
                                                Command="{Binding SetControllerDateTimeCommand}"
                                                Content="{Binding SetControllerRtcButtonText}"
                                                ToolTip.Tip="Send the selected date, time, and time zone to the PDM."
                                                IsEnabled="{Binding CanSetControllerRtc}" />
                                        </Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Opacity="0.75"
                                            Text="Use this when GPS is disabled or unavailable." />
                                    </StackPanel>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            Margin="5"
                                            VerticalAlignment="Center"
                                            Text="Motion detection" />
                                        <ToggleSwitch
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            BorderBrush="#302042"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            IsChecked="{Binding SettingsDataView.SystemParamsStaticData.AllowMotionDetect}"
                                            OffContent="Disabled"
                                            ToolTip.Tip="Allow the IMU to wake the PDM when motion is detected while the vehicle is asleep."
                                            OnContent="Enabled" />
                                    </StackPanel>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            Margin="5"
                                            VerticalAlignment="Center"
                                            Text="Distance units" />
                                        <ToggleSwitch
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            BorderBrush="#302042"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            IsChecked="{Binding SettingsDataView.SystemParamsStaticData.DistanceUnitPref}"
                                            OffContent="Metric"
                                            ToolTip.Tip="Display distance values in metric or imperial units."
                                            OnContent="Imperial" />
                                    </StackPanel>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            Margin="5"
                                            VerticalAlignment="Center"
                                            Text="Speed units" />
                                        <ToggleSwitch
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            BorderBrush="#302042"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            IsChecked="{Binding SettingsDataView.SystemParamsStaticData.SpeedUnitPref}"
                                            OffContent="Metric"
                                            ToolTip.Tip="Display speed values in metric or imperial units."
                                            OnContent="Imperial" />
                                    </StackPanel>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Vertical"
                                        Spacing="0">
                                        <TextBlock
                                            Margin="25,5,5,0"
                                            VerticalAlignment="Center"
                                            Text="System current limit" />
                                        <Grid ColumnDefinitions="Auto, Auto">
                                            <TextBlock
                                                Grid.Column="0"
                                                Width="35"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Text="{Binding #slider.Value}" />
                                            <Slider
                                                x:Name="slider"
                                                Grid.Column="1"
                                                Width="140"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True"
                                                Maximum="150"
                                                Minimum="0"
                                                TickFrequency="1"
                                                ToolTip.Tip="Maximum total current allowed before the controller starts protective action."
                                                Value="{Binding SettingsDataView.SystemParamsStaticData.SystemCurrentLimit}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="6"
                                Padding="14"
                                BorderBrush="#443553"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="9">
                                    <TextBlock
                                        Classes="groupTitle"
                                        Padding="0,0,0,6"
                                        HorizontalAlignment="Center"
                                        Text="CAN" />
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            Margin="5"
                                            VerticalAlignment="Center"
                                            Text="CAN bus resistor" />
                                        <ToggleSwitch
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            BorderBrush="#302042"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            IsChecked="{Binding SettingsDataView.SystemParamsStaticData.CANResEnabled}"
                                            OffContent="Disabled"
                                            ToolTip.Tip="Enable the onboard CAN termination resistor. Use this only when the PDM is at one end of the CAN bus."
                                            OnContent="Enabled" />
                                    </StackPanel>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            Margin="5"
                                            VerticalAlignment="Center"
                                            Text="CAN bus bitrate" />
                                        <ComboBox
                                            Width="120"
                                            HorizontalAlignment="Left"
                                            ItemsSource="{Binding AvailableCanBitrates}"
                                            ToolTip.Tip="Set the CAN bus bitrate used by the PDM. This must match the rest of the CAN network."
                                            SelectedItem="{Binding SelectedCanBusBitrate, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <TextBlock
                                            Margin="5"
                                            VerticalAlignment="Center"
                                            Text="CAN bus addresses"/>
                                    </StackPanel>
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <Grid ColumnDefinitions="Auto, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Current system status ID"
                                                Text="{Binding SettingsDataView.SystemParamsStaticData.SystemDataCANID, StringFormat='System status TX (0x{0:X3})'}" />
                                            <ComboBox
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Width="110"
                                                Margin="0,5,0,0"
                                                HorizontalAlignment="Left"
                                                ItemsSource="{Binding AvailableCanIds}"
                                                ToolTip.Tip="CAN ID used by the PDM to transmit system status."
                                                SelectedItem="{Binding SelectedSystemDataCanId, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Current digital input status ID"
                                                Text="{Binding SettingsDataView.SystemParamsStaticData.DigitalInputDataCANID, StringFormat='Digital input status TX (0x{0:X3})'}" />
                                            <ComboBox
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Width="110"
                                                Margin="0,5,0,0"
                                                HorizontalAlignment="Right"
                                                ItemsSource="{Binding AvailableCanIds}"
                                                ToolTip.Tip="CAN ID used by the PDM to transmit digital input status."
                                                SelectedItem="{Binding SelectedDigitalInputDataCanId, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Current analogue input status ID"
                                                Text="{Binding SettingsDataView.SystemParamsStaticData.AnalogueInputDataCANID, StringFormat='Analogue input status TX (0x{0:X3})'}" />
                                            <ComboBox
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Width="110"
                                                Margin="-8,5,0,0"
                                                HorizontalAlignment="Right"
                                                ItemsSource="{Binding AvailableCanIds}"
                                                ToolTip.Tip="CAN ID used by the PDM to transmit analogue input status."
                                                SelectedItem="{Binding SelectedAnalogueInputDataCanId, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Current channel status ID"
                                                Text="{Binding SettingsDataView.SystemParamsStaticData.ChannelDataCANID, StringFormat='Channel status TX (0x{0:X3})'}" />
                                            <ComboBox
                                                Grid.Row="3"
                                                Grid.Column="2"
                                                Width="110"
                                                Margin="-8,5,0,0"
                                                HorizontalAlignment="Right"
                                                ItemsSource="{Binding AvailableCanIds}"
                                                ToolTip.Tip="CAN ID used by the PDM to transmit output channel status."
                                                SelectedItem="{Binding SelectedChannelDataCanId, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Current channel config ID"
                                                Text="{Binding SettingsDataView.SystemParamsStaticData.ConfigDataCANID, StringFormat='Channel config RX (0x{0:X3})'}" />
                                            <ComboBox
                                                Grid.Row="4"
                                                Grid.Column="2"
                                                Width="110"
                                                Margin="-8,5,0,0"
                                                HorizontalAlignment="Right"
                                                ItemsSource="{Binding AvailableCanIds}"
                                                ToolTip.Tip="CAN ID the PDM listens on for channel configuration commands."
                                                SelectedItem="{Binding SelectedConfigDataCanId, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                Margin="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Current system config ID"
                                                Text="{Binding SettingsDataView.SystemParamsStaticData.SystemConfigCANID, StringFormat='System config RX (0x{0:X3})'}" />
                                            <ComboBox
                                                Grid.Row="5"
                                                Grid.Column="2"
                                                Width="110"
                                                Margin="-8,5,0,0"
                                                HorizontalAlignment="Right"
                                                ItemsSource="{Binding AvailableCanIds}"
                                                ToolTip.Tip="CAN ID the PDM listens on for system configuration commands."
                                                SelectedItem="{Binding SelectedSystemConfigCanId, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="6"
                                Padding="14"
                                BorderBrush="#443553"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Vertical"
                                    Spacing="9">
                                    <TextBlock
                                        Classes="groupTitle"
                                        Margin="5"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Text="Cortex App" />
                                    <StackPanel
                                        Margin="0,5,0,10"
                                        HorizontalAlignment="Center"
                                        Orientation="Vertical"
                                        Spacing="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Text="{Binding CurrentApplicationVersionDisplay, StringFormat='Current version: {0}'}" />
                                        <TextBlock
                                            Width="230"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap"
                                            Text="{Binding ApplicationUpdateStatusMessage}" />
                                        <Button
                                            Width="170"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Background="{Binding ApplicationUpdateButtonBackground}"
                                            Command="{Binding CheckForApplicationUpdateCommand}"
                                            Content="{Binding ApplicationUpdateButtonText}"
                                            ToolTip.Tip="Check GitHub for a newer Cortex application release."
                                            IsEnabled="{Binding CanCheckForApplicationUpdate}" />
                                        <Button
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding OpenLatestApplicationOnGitHubCommand}"
                                            IsVisible="{Binding HasLatestApplicationGitHubLink}">
                                            <TextBlock
                                                Foreground="#7EB6FF"
                                                Text="{Binding LatestApplicationGitHubLinkText}"
                                                TextDecorations="Underline" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock
                                        Classes="groupTitle"
                                        Margin="5"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Text="System Firmware" />
                                    <StackPanel
                                        Margin="0,5,0,10"
                                        HorizontalAlignment="Center"
                                        Orientation="Vertical"
                                        Spacing="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Text="{Binding CurrentFirmwareVersionDisplay, StringFormat='Current version: {0}'}" />
                                        <Button
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding OpenLatestFirmwareOnGitHubCommand}"
                                            IsVisible="{Binding HasLatestFirmwareGitHubLink}">
                                            <TextBlock
                                                Foreground="#7EB6FF"
                                                Text="{Binding LatestFirmwareGitHubLinkText}"
                                                TextDecorations="Underline" />
                                        </Button>
                                        <Button
                                            Width="170"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Background="{Binding FirmwareUpdateButtonBackground}"
                                            Command="{Binding OpenFirmwareUpdateCommand}"
                                            Content="{Binding FirmwareUpdateButtonText}"
                                            ToolTip.Tip="Open the firmware update workflow using the latest available release."
                                            IsEnabled="{Binding CanOpenFirmwareUpdateDialog}"/>
                                        <Button
                                            Width="170"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding OpenLocalFirmwareUpdateCommand}"
                                            Content="Install local files..."
                                            ToolTip.Tip="Install firmware files selected from this computer."
                                            IsEnabled="{Binding CanOpenLocalFirmwareUpdateDialog}"/>
                                    </StackPanel>
                                    <TextBlock
                                        Classes="groupTitle"
                                        Margin="5"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Text="Factory Reset" />
                                    <StackPanel
                                        Margin="0,5,0,10"
                                        HorizontalAlignment="Center"
                                        Orientation="Vertical"
                                        Spacing="8">
                                        <Button
                                            Width="170"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding FactoryResetCommand}"
                                            Content="{Binding FactoryResetButtonText}"
                                            ToolTip.Tip="Reset the PDM configuration back to firmware defaults."
                                            IsEnabled="{Binding CanFactoryReset}"/>
                                        <TextBlock
                                            Width="220"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap"
                                            Foreground="#FFD7B66B"
                                            IsVisible="{Binding IsFactoryResetInProgress}"
                                            Text="{Binding FactoryResetStatusMessage}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="150"
                Margin="5,0,10,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                Command="{Binding RevertChangesCommand}"
                IsEnabled="{Binding HasPendingConfigChanges}"
                ToolTip.Tip="Restore controller parameters"
                Content="REVERT CHANGES" />
            <Button
                Width="150"
                Margin="5,0,10,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                Background="#B30000"
                Command="{Binding SendConfigCommand}"
                IsEnabled="{Binding CanSendConfig}"
                Content="SAVE CHANGES" />
        </StackPanel>
    </Grid>
</UserControl>
